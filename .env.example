# Kopieer dit bestand naar .env en vul één blok in. Commit .env nooit.

# --- Blok 1: Roboest-endpoint (standaard) ---
# Je teamkey staat op het Teamkaartje dat je om 10:00 van een coach krijgt.
# Eén key per team, $5 budget, geldig op 24/11 tot 18:00. Deel hem niet met andere teams.
OPENAI_BASE_URL=https://roboest.findingsolutions.be/v1
OPENAI_API_KEY=<teamkey van je Teamkaartje>
MODEL_KLEIN=achrona
MODEL_GROOT=achrona-groot

# --- Blok 2: FreeLLMAPI op je eigen laptop (optioneel, gratis) ---
# Budget op, of wil je zelf modellen kiezen? Zie "FreeLLMAPI (optioneel)" in de README.
# OPENAI_BASE_URL=http://localhost:3001/v1
# OPENAI_API_KEY=<unified-key>
# MODEL_KLEIN=auto:fast
# MODEL_GROOT=auto:smartest

# --- Blok 3: Ollama lokaal (eigen model, zonder support) ---
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama
# MODEL_KLEIN=qwen3:8b
# MODEL_GROOT=qwen3:8b

# --- Kennisbronnen ---
# MCP-pad per Raadslid: MCP_<ROL>=https://<mcp-host>/<rol>/mcp (de link krijg je om 10:00).
# Leeg = fallback: de bestanden in kennisbronnen/<rol>/ gaan in de prompt.
MCP_BEAST_MASTER=
MCP_ORACLE=
# Voeg je een Raadslid toe? Zet dan ook zijn pad, bv.:
# MCP_ARCHMAGE=https://<mcp-host>/archmage/mcp
# MCP_ENGINEER=https://<mcp-host>/engineer/mcp
# MCP_GUARDIAN_KEEPER=https://<mcp-host>/guardian_keeper/mcp
# MCP_HISTORIAN=https://<mcp-host>/historian/mcp

# REASONING (minimal|low|medium|high) werkt alleen bij redeneermodellen; weglaten = standaard van het model.

# De Koning (MODEL_GROOT) kiest elke beurt zelf wie spreekt en wanneer het debat stopt.
# Het Beurtenbudget (maximaal 10 Raadslid-beurten per run) geldt altijd.
